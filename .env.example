# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your values.
# .env is git-ignored: never commit real credentials.
# Every value here can also be supplied as a real environment variable,
# which takes precedence over this file.
# ---------------------------------------------------------------------------

# Telegram api key from https://telegram.me/BotFather
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Provider keys
# ---------------------------------------------------------------------------
# Any provider with a key set joins the failover chain automatically, in the
# order listed in config.yaml. You only need one key to start; every extra key
# makes the bot more resilient and faster.

# OpenRouter https://openrouter.ai/settings/keys - also enables cost accounting
API_KEY=
# Groq https://console.groq.com/keys - very fast, generous free tier
GROQ_API_KEY=
# Google Gemini https://aistudio.google.com/apikey - 1M context and vision
GEMINI_API_KEY=
# Cerebras https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# NVIDIA NIM https://build.nvidia.com
NVIDIA_API_KEY=
# Mistral https://console.mistral.ai
MISTRAL_API_KEY=
# Hugging Face inference providers https://huggingface.co/settings/tokens
HF_TOKEN=
# DeepSeek https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Together https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
SAMBANOVA_API_KEY=

# ---------------------------------------------------------------------------
# User owned providers
# ---------------------------------------------------------------------------
# Master key that seals the API keys users add with /addprovider (AES-256-GCM).
# Generate one with: openssl rand -hex 32
# Without it, /addprovider is disabled instead of storing keys in plaintext.
USER_PROVIDER_ENCRYPTION_KEY=

# Optional: a local Ollama endpoint. No key needed, nothing is sent to a
# third party. Uncomment the ollama provider in config.yaml as well.
#OLLAMA_BASE_URL=http://localhost:11434

# Optional: your own Bot API server instead of api.telegram.org.
#TELEGRAM_API_URL=http://localhost:8081/bot%s/%s

# Your Telegram id from https://t.me/getmyid_bot
ADMIN_IDS=
# List of users to access the bot, separated by commas.
# Leave empty to allow everyone (they are then treated as USER, not GUEST).
ALLOWED_USER_IDS=

# ---------------------------------------------------------------------------
# Budgets (in USD, per BUDGET_PERIOD)
#   USER_BUDGET  - allowance for admins (unlimited) and allowed users
#   GUEST_BUDGET - allowance for everybody else; 0 blocks guests
# ---------------------------------------------------------------------------
USER_BUDGET=1
GUEST_BUDGET=0

# Budget period: daily, monthly or total
BUDGET_PERIOD=monthly

# ---------------------------------------------------------------------------
# Public mode
# ---------------------------------------------------------------------------
#
# true  = everyone can use the bot without any limit, in private chats and in
#         groups. Budgets become unlimited, rate limiting is switched off and
#         the bot answers every group message.
# false = budgets, rate limits and GROUP_CHAT_MODE apply as configured below.
#
# WARNING: with this enabled, anyone who finds your bot can spend your
# provider credits. Set a hard spending limit on the provider side too.
PUBLIC_MODE=true

# Who may use the bot in a group: everyone, admins or owner.
# Any group admin can change it for their own group from the /group panel.
GROUP_ACCESS=everyone

# Who may use the bot in a direct message: everyone, admins or owner.
# PUBLIC_MODE forces everyone.
PRIVATE_ACCESS=everyone

# Where per-user preferences, favourites and spend are stored.
# Point this at a mounted volume in a container, e.g. /openrouter-bot/data/logs
LOGS_DIR=logs

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# Default base url for OpenRouter API
BASE_URL=https://openrouter.ai/api/v1
# List of free models: https://openrouter.ai/models?max_price=0
MODEL=deepseek/deepseek-r1:free

# Using local LLM via LM Studio (https://lmstudio.ai)
#BASE_URL=http://localhost:1234/v1
#MODEL=llama-3-8b-gpt-4o-ru1.0

# Model settings (default values)
#MAX_TOKENS=2000
#TEMPERATURE=0.7
#TOP_P=0.7
#FREQUENCY_PENALTY=0
#PRESENCE_PENALTY=0

# Longest answer the bot will send (Telegram rejects more than 4096 characters)
MAX_REPLY_CHARS=3500

# Render answers as Markdown (headings, bullets, tables, code blocks). The
# renderer falls back to plain text when Telegram rejects the markup.
RENDER_MARKDOWN=true

# Occasionally suggest a model that suits your usage better
SUGGEST_MODELS=true

# System preset that specifies the role for AI
#ASSISTANT_PROMPT="You are a helpful assistant."

# Replace the built-in response rules. Keep it plain text.
#PERSONA_PROMPT="You are a friendly and smart Telegram assistant."

# ---------------------------------------------------------------------------
# Vision
# ---------------------------------------------------------------------------

# Enable analysis of transmitted images (true/false)
VISION=false
#VISION_PROMPT="Describe the image"
#VISION_DETAIL="low"

# ---------------------------------------------------------------------------
# Conversation history
# ---------------------------------------------------------------------------

# The maximum number of messages or time in minutes for store messages in history
MAX_HISTORY_SIZE=20  # default 10
MAX_HISTORY_TIME=120 # default 60

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Language used for bot responses (supported: EN/RU)
LANG=EN

# Who can receive statistics (ADMIN/USER/GUEST)
STATS_MIN_ROLE=ADMIN

# How the bot behaves in group chats:
#   mention - answer only when mentioned or replied to (default)
#   all     - answer every group message
#   off     - never answer in groups
GROUP_CHAT_MODE=mention

# Max AI requests per user per minute (0 disables rate limiting)
RATE_LIMIT_PER_MINUTE=10

# Max AI requests running at the same time
MAX_CONCURRENT_REQUESTS=8

# Total timeout for one request, including streaming (seconds)
REQUEST_TIMEOUT_SECONDS=300

# Abort a stream that delivers nothing for this long (seconds)
STREAM_IDLE_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Agent, File Intelligence, Token Optimization & Optional Storage/Redis/Voice
# ---------------------------------------------------------------------------

# Maximum steps for /agent tool execution (1..10)
MAX_AGENT_STEPS=4

# Maximum file upload size in bytes for document intelligence (default 10 MiB)
MAX_FILE_SIZE=10485760

# Token & context window optimization
MAX_CONTEXT_MESSAGES=12
MAX_CONTEXT_TOKENS=6000
SUMMARY_THRESHOLD=8

# Storage backend: "json" (default, zero external dependencies) or "postgres"
STORAGE_TYPE=json
#POSTGRES_DSN=postgres://user:pass@localhost:5432/openrouter_bot

# Optional Redis for distributed rate limiting, caching, and locks
#REDIS_URL=redis://localhost:6379/0

# Optional speech-to-text endpoint override (defaults to Groq Whisper when GROQ_API_KEY is set)
#VOICE_STT_BASE_URL=https://api.groq.com/openai/v1
#VOICE_STT_API_KEY=
#VOICE_STT_MODEL=whisper-large-v3-turbo
