# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your values.
# .env is git-ignored: never commit real credentials.
# Every value here can also be supplied as a real environment variable,
# which takes precedence over this file.
# ---------------------------------------------------------------------------

# OpenRouter api key from https://openrouter.ai/settings/keys
API_KEY=

# Telegram api key from https://telegram.me/BotFather
TELEGRAM_BOT_TOKEN=

# Optional extra providers. Any of these can serve requests; the bot walks
# them in the order defined in config.yaml and fails over automatically.
# https://console.groq.com/keys
GROQ_API_KEY=
# https://cloud.cerebras.ai  (also add the "cerebras" block in config.yaml)
CEREBRAS_API_KEY=
# https://build.nvidia.com
NVIDIA_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Your Telegram id from https://t.me/getmyid_bot
ADMIN_IDS=
# List of users to access the bot, separated by commas.
# Leave empty to allow everyone (they are then treated as USER, not GUEST).
ALLOWED_USER_IDS=

# ---------------------------------------------------------------------------
# Budgets (in USD, per BUDGET_PERIOD)
#   USER_BUDGET  - allowance for admins (unlimited) and allowed users
#   GUEST_BUDGET - allowance for everybody else; 0 blocks guests
# ---------------------------------------------------------------------------
USER_BUDGET=1
GUEST_BUDGET=0

# Budget period: daily, monthly or total
BUDGET_PERIOD=monthly

# ---------------------------------------------------------------------------
# Public mode
# ---------------------------------------------------------------------------
#
# true  = everyone can use the bot without any limit, in private chats and in
#         groups. Budgets become unlimited, rate limiting is switched off and
#         the bot answers every group message.
# false = budgets, rate limits and GROUP_CHAT_MODE apply as configured below.
#
# WARNING: with this enabled, anyone who finds your bot can spend your
# provider credits. Set a hard spending limit on the provider side too.
PUBLIC_MODE=true

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# Default base url for OpenRouter API
BASE_URL=https://openrouter.ai/api/v1
# List of free models: https://openrouter.ai/models?max_price=0
MODEL=deepseek/deepseek-r1:free

# Using local LLM via LM Studio (https://lmstudio.ai)
#BASE_URL=http://localhost:1234/v1
#MODEL=llama-3-8b-gpt-4o-ru1.0

# Model settings (default values)
#MAX_TOKENS=2000
#TEMPERATURE=0.7
#TOP_P=0.7
#FREQUENCY_PENALTY=0
#PRESENCE_PENALTY=0

# System preset that specifies the role for AI
#ASSISTANT_PROMPT="You are a helpful assistant."

# ---------------------------------------------------------------------------
# Vision
# ---------------------------------------------------------------------------

# Enable analysis of transmitted images (true/false)
VISION=false
#VISION_PROMPT="Describe the image"
#VISION_DETAIL="low"

# ---------------------------------------------------------------------------
# Conversation history
# ---------------------------------------------------------------------------

# The maximum number of messages or time in minutes for store messages in history
MAX_HISTORY_SIZE=20  # default 10
MAX_HISTORY_TIME=120 # default 60

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Language used for bot responses (supported: EN/RU)
LANG=EN

# Who can receive statistics (ADMIN/USER/GUEST)
STATS_MIN_ROLE=ADMIN

# How the bot behaves in group chats:
#   mention - answer only when mentioned or replied to (default)
#   all     - answer every group message
#   off     - never answer in groups
GROUP_CHAT_MODE=mention

# Max AI requests per user per minute (0 disables rate limiting)
RATE_LIMIT_PER_MINUTE=10

# Max AI requests running at the same time
MAX_CONCURRENT_REQUESTS=8

# Total timeout for one request, including streaming (seconds)
REQUEST_TIMEOUT_SECONDS=300

# Abort a stream that delivers nothing for this long (seconds)
STREAM_IDLE_TIMEOUT_SECONDS=120
